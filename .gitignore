# ============================================================
# ExamGuard — .gitignore
# ============================================================

# --- Security: Credentials & Sensitive Data ---
users.json

# --- Model Weights (Large Binary Files) ---
# Host these on Google Drive / Hugging Face / GitHub Releases instead
*.pt
*.weights
*.onnx
*.h5
*.pb

# --- Python Cache & Bytecode ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# --- Runtime-Generated Output Folders ---
# These are created at runtime — keep the folders but not their contents
Reports/*
!Reports/.gitkeep
uploads/*
!uploads/.gitkeep
processed_outputs/*
!processed_outputs/.gitkeep

# --- Environment & Secrets ---
.env
.env.*
*.secret
config.local.py

# --- Data Files ---
*.csv
*.xlsx
*.xml

# --- Media / Evidence Files ---
*.jpg
*.jpeg
*.png
*.gif
*.mp4
*.avi
*.mov

# --- PDF Reports ---
*.pdf

# --- Dataset Folders ---
/dataset/
/data/
/images/
/videos/
/models/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- IDE & Editor Files ---
.vscode/
.idea/
*.suo
*.user

# --- OS Junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Temporary Files ---
tempCodeRunnerFile.py
*.tmp
*.log

# --- Logs ---
logs/
evidence/